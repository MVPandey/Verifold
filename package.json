{
  "name": "verifold",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:cli && tsc --noEmit && vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run test:package",
    "build:cli": "node -e \"require('node:fs').rmSync('dist-cli', { recursive: true, force: true })\" && tsc -p tsconfig.cli.json",
    "test:package": "node scripts/package-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.10.0",
    "globals": "16.5.0",
    "node": "24.20.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6"
  },
  "bin": {
    "verifold": "dist-cli/cli.js"
  },
  "files": [
    "dist-cli"
  ],
  "license": "UNLICENSED"
}
