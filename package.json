{
  "name": "verifold",
  "version": "0.3.0",
  "description": "A research project CLI for coordinating existing AI agent harnesses.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MVPandey/Verifold.git"
  },
  "homepage": "https://github.com/MVPandey/Verifold#readme",
  "bugs": "https://github.com/MVPandey/Verifold/issues",
  "author": "Manav Pandey",
  "keywords": [
    "research",
    "agents",
    "cli",
    "claude",
    "codex"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:cli && tsc --noEmit && vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "check:private": "node scripts/check-private-files.mjs",
    "validate": "npm run check:private && npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run test:package",
    "build:cli": "node -e \"require('node:fs').rmSync('dist-cli', { recursive: true, force: true })\" && tsc -p tsconfig.cli.json && node scripts/build-cli-assets.mjs",
    "test:package": "node scripts/package-check.mjs",
    "audit:security": "npm audit --audit-level=high && npm audit signatures",
    "prepublishOnly": "npm run validate && npm run audit:security"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.5.0",
    "eslint": "10.10.0",
    "globals": "16.5.0",
    "node": "26.8.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6"
  },
  "bin": {
    "verifold": "dist-cli/cli.js"
  },
  "files": [
    "dist-cli/cli.js",
    "dist-cli/cli/",
    "dist-cli/domain/profile.js",
    "dist-cli/ui/dom.js",
    "LICENSING.md",
    "SECURITY.md"
  ],
  "license": "MIT"
}
